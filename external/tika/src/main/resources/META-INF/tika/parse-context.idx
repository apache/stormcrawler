# Registers Tika's IdentityHtmlMapper so that the ParserBolt can send it to
# the forked JVMs used by Tika Pipes (parser.tika.timeout); Tika only
# serialises the ParseContext components which are listed in these files.
# Format: component-name=fully.qualified.ClassName[:key=contextKeyClass]
identity-html-mapper=org.apache.tika.parser.html.IdentityHtmlMapper:key=org.apache.tika.parser.html.HtmlMapper
